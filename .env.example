# MongoDB Connection String (from MongoDB Atlas)
# REQUIRED in production. Without this, development falls back to in-memory storage
# and production startup will fail fast to prevent silent data/session loss.
# Complete format: mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority&appName=<AppName>
# Example (with database name): mongodb+srv://myuser:mypassword@cluster0.mpmy7ir.mongodb.net/tobseytech?retryWrites=true&w=majority&appName=Cluster0
# Example (no database name):   mongodb+srv://myuser:mypassword@cluster0.mpmy7ir.mongodb.net/?appName=Cluster0
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mpmy7ir.mongodb.net/?appName=Cluster0

# Session secret
# Strongly recommended in production. Without it, a random secret is generated
# on each startup and all sessions (logins) are lost every time the server restarts.
# Never commit a real secret to git; set it in your host's environment settings.
SESSION_SECRET=change-me-to-a-long-random-secret

# Admin dashboard secondary password
# REQUIRED in production to access /dashboard even as admin.
ADMIN_DASHBOARD_PASSWORD=onebroonecode

# Seed credentials for the primary admin account (username: tbeetech)
# Optional in development. In production, set both values together if you want the
# app to create/sync the primary admin account on startup.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me-to-a-strong-admin-password

# Optional: SMTP settings for contact form emails and password-reset emails
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Public URL of the app (used in password-reset links)
# Render:  APP_URL=https://your-app.onrender.com
# Vercel:  APP_URL=https://your-app.vercel.app
APP_URL=https://your-app.onrender.com

# Server port (defaults to 5000)
PORT=5000

# OpenAI API key — required for Prophet AI (navigation & questioner AI)
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Perplexity API key — required for Cosmo Research AI (cosmo-tech & political research panel)
# Get yours at https://www.perplexity.ai/settings/api
# If not set, Cosmo Research AI falls back to OpenAI GPT-4o-mini
PERPLEXITY_API_KEY=pplx-...
