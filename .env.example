# MongoDB Connection String (from MongoDB Atlas)
# Complete format: mongodb+srv://<username>:<password>@<cluster-name>.<cluster-id>.mongodb.net/<database>?retryWrites=true&w=majority&appName=<AppName>
# Example:        mongodb+srv://myuser:mypassword@cluster0.abc1234.mongodb.net/tobseytech?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.<cluster-id>.mongodb.net/<database>?retryWrites=true&w=majority&appName=<AppName>

# Session secret (use a long random string in production)
SESSION_SECRET=change-me-to-a-long-random-secret

# Admin dashboard secondary password (required to access /dashboard even as admin)
ADMIN_DASHBOARD_PASSWORD=change-me-to-a-strong-dashboard-password

# Seed credentials for the primary admin account (username: tbeetech)
# Both values are required for the admin user to be created/promoted on startup.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me-to-a-strong-admin-password

# Optional: SMTP settings for contact form emails
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Server port (defaults to 5000)
PORT=5000
